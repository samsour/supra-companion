# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Mapbox public access token (Day 2+)
VITE_MAPBOX_TOKEN=pk.YOUR-TOKEN
